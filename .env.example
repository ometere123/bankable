# Copy to .env (never commit .env). No value here is a secret.
# Two distinct documented QIE mainnet endpoints (spec section 4.2, 6.1).
QIE_RPC_A=https://rpc1mainnet.qie.digital
QIE_RPC_B=https://rpc5mainnet.qie.digital
QIE_CHAIN_ID=1990
# QUSDC token (spec section 4.2)
QUSDC_ADDRESS=0x3F43DA82eC9A4f5285F10FaF1F26EcA7319E5DA5
# Set after deployment (contracts/deployments/mainnet.json is the source of truth)
STATEMENT_REGISTRY_ADDRESS=0x1E9FC096bebe1f142AeeD317d0054583E9227804
# Fixed verifier origin; part of the renderer profile (spec 5.2). Decided before generating real fixtures.
BANKABLE_ORIGIN=https://bankable-qie.vercel.app
# Deployment only. Supply via your shell or secret manager; NEVER commit.
DEPLOYER_PRIVATE_KEY=

# Public build variable for the web app (same registry address)
NEXT_PUBLIC_REGISTRY_ADDRESS=0x1E9FC096bebe1f142AeeD317d0054583E9227804
